generator client {
  provider = "prisma-client"
  output   = "../../frontend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
}

enum VideoStatus {
  PENDING
  SCRIPTING
  VOICING
  FETCHING_VISUALS
  RENDERING
  READY
  PUBLISHING
  PUBLISHED
  FAILED
}

enum ScheduledStatus {
  WAITING
  PUBLISHED
  CANCELLED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  videos       Video[]
}

model ConnectedAccount {
  id            String    @id @default(cuid())
  platform      Platform  @unique
  accessToken   String    @db.Text
  refreshToken  String?   @db.Text
  expiresAt     DateTime?
  accountHandle String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Niche {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  nameEn               String
  nameNe               String
  emoji                String
  language             String
  psychologicalTrigger String      @db.Text
  targetEmotion        String      @db.Text
  contentAngle         String      @db.Text
  pexelsKeywords       String[]
  captionColor         String
  voiceTone            String
  defaultVoiceId       String
  systemPrompt         String      @db.Text
  exampleHooks         String[]
  isActive             Boolean     @default(true)
  sortOrder            Int
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  videos               Video[]
  topicIdeas           TopicIdea[]
}

model Video {
  id              String           @id @default(cuid())
  title           String?
  nicheId         String
  niche           Niche            @relation(fields: [nicheId], references: [id])
  creatorId       String
  creator         User             @relation(fields: [creatorId], references: [id])
  scriptJson      Json?
  voiceId         String?
  voiceProvider   String?
  audioPath       String?
  visualsJson     Json?
  visualStyle     String?          @default("PEXELS")
  videoPath       String?
  thumbnailPath   String?
  durationSeconds Float?
  status          VideoStatus      @default(PENDING)
  errorMessage    String?          @db.Text
  renderStartedAt DateTime?
  renderEndedAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishedVideos PublishedVideo[]
  scheduledVideos ScheduledVideo[]
}

model PublishedVideo {
  id                 String    @id @default(cuid())
  videoId            String
  video              Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  platform           Platform
  platformPostId     String?
  publicUrl          String?
  publishedAt        DateTime?
  views              Int       @default(0)
  likes              Int       @default(0)
  comments           Int       @default(0)
  metricsRefreshedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([videoId, platform])
}

model ScheduledVideo {
  id        String          @id @default(cuid())
  videoId   String
  video     Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  targetAt  DateTime
  platforms Platform[]
  status    ScheduledStatus @default(WAITING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model TopicIdea {
  id             String   @id @default(cuid())
  nicheId        String
  niche          Niche    @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  title          String
  hookPreview    String
  language       String
  trendingScore  Float    @default(0)
  isUsed         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
