# NextAuth
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Database
# For local development, this can be a PostgreSQL connection string (e.g., Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/storyforge
# Direct Postgres URL for Prisma driver adapter (required with Prisma 7)
# When using `npx prisma dev`, use the postgres:// URL it prints (not prisma+postgres://)
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable

# Redis (Job Queue)
# Next.js uses UPSTASH REST URL/TOKEN, Python worker uses standard redis:// URL
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
REDIS_URL=redis://default:your_redis_password@your-redis-instance.upstash.io:6379

# AI APIs — script & topic generation (Groq recommended for local testing)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=your_anthropic_api_key_here
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Google Cloud (TTS)
GOOGLE_APPLICATION_CREDENTIALS=/home/root1/StoryForge/google-creds.json
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id_here

# Pexels (Stock footage)
PEXELS_API_KEY=your_pexels_api_key_here

# Cloudflare R2 (Object Storage)
CLOUDFLARE_R2_BUCKET_NAME=storyforge-media
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your_cloudflare_public_id.r2.dev

# Social Publishing APIs
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FB_PAGE_ID=your_facebook_page_id
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token

YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# Paths and Configs
VIDEO_TEMP_DIR=/tmp/storyforge
VIDEO_OUTPUT_DIR=/home/root1/StoryForge/frontend/public/outputs
WORKER_PYTHON=/home/root1/StoryForge/backend/worker/venv/bin/python
WORKER_SCRIPT=/home/root1/StoryForge/backend/worker/voice/generate_voice.py
WORKER_VISUAL_SCRIPT=/home/root1/StoryForge/backend/worker/visuals/fetch_visuals.py
WORKER_RENDER_SCRIPT=/home/root1/StoryForge/backend/worker/render/render_video.py
FFMPEG_PATH=/home/root1/StoryForge/backend/bin/ffmpeg
FFPROBE_PATH=/home/root1/StoryForge/backend/bin/ffprobe
FONTCONFIG_FILE=/home/root1/StoryForge/backend/fonts/fonts.conf
STORYFORGE_FONTS_DIR=/home/root1/StoryForge/backend/fonts

DEFAULT_VISUAL_STYLE=PEXELS
DEFAULT_LANGUAGE=nepali
AUTO_PUBLISH_SCHEDULE=0 8,13,19 * * *
METRICS_REFRESH_SCHEDULE=0 0 * * *
MAX_CONCURRENT_RENDERS=2
